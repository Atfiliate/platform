<div style="margin-bottom: 4px;">
	<md-toolbar class="md-hue-2">
		<div class="md-toolbar-tools">
			<h2 flex md-truncate>Site Pair Updates</h2>
			<md-button aria-label="delete all pair update notifications" 
				ng-show="temp.showPairUpdates && edit.$updates && edit.$updates.length"
				ng-click="addon.edit.browse.update.removeAll()">Delete All</md-button>
			<md-button class="md-icon-button"
				aria-label="Toggle pair updates"
				ng-click="addon.edit.browse.update.toggle()">
				<i class="fa" ng-class="temp.showPairUpdates ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
			</md-button>
		</div>
	</md-toolbar>

	<div ng-show="temp.showPairUpdates">
		<div class="insight-placeholder" ng-if="edit.$updatesLoading">
			Loading updates...
		</div>

		<md-list ng-if="!edit.$updatesLoading && edit.$updates && edit.$updates.length">
			<md-list-item class="md-3-line" ng-repeat="update in edit.$updates | orderBy:'-updatedOn'" ng-click="addon.edit.browse.update.review(update)">
				<div class="md-list-item-text">
					<h3>{{update.serverMeta.origin}}</h3>
					<p>{{moment(update.updatedOn).calendar()}}</p>
					<p>{{update.var.notes}}</p>
				</div>
				<md-menu>
					<md-button aria-label="Menu" class="md-icon-button" ng-click="$mdMenu.open($event)"><i class="fa fa-bars"></i></md-button>
					<md-menu-content width="4">
						<md-menu-item ng-show="v != edit.project">
							<md-button ng-click="addon.edit.variation.compare(update)">
								<i class="fa fa-code-fork"></i> Compare
							</md-button>
						</md-menu-item>
						<md-menu-item>
							<md-menu>
								<md-button ng-click="$mdMenu.open()"><i class="fa fa-thumbs-o-up"></i> Promote To Prod</md-button>
								<md-menu-content width="3">
									<md-menu-item ng-repeat="pv in edit.$variations | orderBy:'updatedOn'" ng-if="pv.stage=='prod'">
										<md-button aria-label="Merge into {{pv.var.title}}" ng-click="addon.edit.variation.promote(update, pv)">{{pv.var.title}}</md-button>
									</md-menu-item>
									<md-menu-item><md-button aria-label="New" ng-click="addon.edit.variation.promote(update, 'new')">Add A Variant</md-button></md-menu-item>
								</md-menu-content>
							</md-menu>
						</md-menu-item>
						<md-menu-item>
							<md-button ng-click="addon.edit.browse.update.remove(update)">
								<i class="fa fa-trash"></i> Delete
							</md-button>
						</md-menu-item>
					</md-menu-content>
				</md-menu>
			</md-list-item>
		</md-list>

		<div class="insight-placeholder" ng-if="!edit.$updatesLoading && edit.$updatesLoaded && !(edit.$updates && edit.$updates.length)">
			No pair updates found.
		</div>
	</div>
</div>

<div>
	<md-toolbar class="md-hue-2">
		<div class="md-toolbar-tools">
			<h2 flex md-truncate>{{edit.browse || 'Market'}}</h2>
			<md-button class="md-raised" ng-click="addon.edit.package.publish(edit.project)">Publish</md-button>
			<md-button ng-hide="edit.browse=='Market'" class="md-raised" ng-click="addon.edit.browse.market()">Market</md-button>
			<md-button ng-hide="edit.browse=='Local'" class="md-raised" ng-click="addon.edit.browse.local()">Local</md-button>
		</div>
	</md-toolbar>

	<md-list ng-if="edit.browse=='Market'">
		<md-list-item ng-repeat="v in $market" class="md-3-line" ng-click="addon.edit.browse.view(v)">
			<div class="md-list-item-text">
				<h3>{{v.serverMeta.origin}}</h3>
				<p ng-if="v.var.price">{{v.var.price | currency}}/{{v.var.unit}}</p>
				<p>{{v.var.notes}}</p>
			</div>
		</md-list-item>
	</md-list>

	<md-list ng-if="edit.browse=='Local'">
		<md-list-item ng-repeat="v in $market" class="md-3-line" ng-click="addon.edit.browse.view(v)">
			<div class="md-list-item-text">
				<h3>{{v.meta.title}}</h3>
				<p>{{v.default ? 'Default' : 'Alternate'}}</p>
				<p>{{moment(v.updatedOn).fromNow()}}</p>
			</div>
		</md-list-item>
	</md-list>
</div>