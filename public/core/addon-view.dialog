<md-dialog layout-padding style="width:500px; max-width:90%; min-height:50vh;">
	<md-toolbar>
		<div class="md-toolbar-tools" layout="row">
			<h2 flex>Addon</h2>
			<md-button class="md-icon-button" aria-label="Close" ng-click="$mdDialog.hide()"><i class="fa fa-close"></i></md-button>
		</div>
	</md-toolbar>
	<md-content>
		<h3>{{tools.addon._focus.meta.title}}</h3>
		<p>{{tools.addon._focus.version}}</p>
		<p>{{tools.addon._focus.description}}</p>
		<div ng-show="user.is('root')">
			<md-switch ng-model="tools.addon._focus.required" aria-label="Require">
				Require
			</md-switch>
			<md-switch ng-model="tools.addon._focus.suggested" aria-label="Only Suggest">
				Only Suggest
			</md-switch>
			
			<md-input-container>
				<label>Price</label>
				<input type="number" ng-model="tools.addon._focus.price.amount">
			</md-input-container>
			<md-input-container>
				<label>Interval</label>
				<input ng-model="tools.addon._focus.price.interval">
				<p class="hint">once,monthly,yearly</p>
			</md-input-container>
		</div>
	</md-content>
	<md-dialog-actions layout="row">
		<md-button class="md-raised md-warn" aria-label="Remove" ng-show="tools.addon._focus.installedOn" ng-click="tools.addon.uninstall(tools.addon._focus).then($mdDialog.hide)">Uninstall</md-button>
		<md-button class="md-raised" aria-label="Copy URL" ng-click="tools.copy(tools.addon._focus.url,'Link Copied')">Copy</md-button>
		<span flex></span>
		<md-button class="md-raised" aria-label="Close" ng-click="$mdDialog.hide()">Close</md-button>
		<md-button class="md-raised md-primary" aria-label="Install" ng-hide="tools.addon._focus.installedOn" ng-click="tools.addon.install(tools.addon._focus.meta).then($mdDialog.hide)">Install</md-button>
	</md-dialog-actions>
</md-dialog>