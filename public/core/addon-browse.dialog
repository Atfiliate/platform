<md-dialog layout-padding style="width:500px; max-width:90%; min-height:50vh;">
	<md-toolbar>
		<div class="md-toolbar-tools" layout="row">
			<h2 flex>Addon Suggestions</h2>
			<md-button class="md-icon-button" aria-label="Close" ng-click="$mdDialog.hide()"><i class="fa fa-close"></i></md-button>
		</div>
	</md-toolbar>
	<md-content>
		<p>Would you like to install any of the following addons?</p>
		<md-list layout-margin>
			<md-list-item class="md-3-line" md-whiteframe="1" ng-repeat="addon in tools.addon._browseList">
				<img ng-src="{{addon.img}}" class="md-avatar" alt=""/>
				<div class="md-list-item-text" layout="column">
					<h3>{{addon.title}}</h3>
					<p class="blue" ng-if="addon.price.amount">Price: {{addon.price.amount|currency}}/{{addon.price.interval}}</p>
					<p>{{addon.description}}</p>
				</div>
				<md-button class="md-secondary md-raised" ng-hide="addon.$installed" aria-label="Install {{addon.title}}" ng-click="tools.addon.install(addon)">Install</md-button>
				<md-button class="md-secondary md-raised" ng-show="addon.$installed" aria-label="Is Installed" disabled="true">Installed</md-button>
			</md-list-item>
		</md-list>
	</md-content>
	<md-dialog-actions layout="row">
		<md-button class="md-icon-button md-secondary" aria-label="Devs" ng-click="tools.addon.dev.init()"><i class="fa fa-upload"></i></md-button>
		<span flex></span>
		<md-button class="md-raised" aria-label="Close" ng-click="$mdDialog.hide()">Close</md-button>
	</md-dialog-actions>
</md-dialog>