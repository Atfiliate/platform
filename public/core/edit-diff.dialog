<link href="https://unpkg.com/ace-diff@^2.0.0/dist/ace-diff-dark.min.css" rel="stylesheet">
<md-dialog aria-label="Code Diff" style="width: 96vw; height:90vh; max-width: 96vw; max-height:90vh;">
	<md-toolbar>
		<div class="md-toolbar-tools">
			<h2>Code Diff: {{diffs.title}}</h2>
			<span flex></span>
			<md-button class="md-icon-button" ng-click="$mdDialog.hide()">
				<md-icon><i class="fa fa-close"></i></md-icon>
			</md-button>
		</div>
	</md-toolbar>
	<md-content>
		<div id="codediff" style="width:100%; height:75vh;"></div>
	</md-content>
	<md-dialog-actions layout="row">
		<md-button ng-click="addon.edit.code.applyDiff('left')">
			Apply {{diffs.left.title}}
		</md-button>
		<span flex></span>
		<md-button ng-click="$mdDialog.cancel()">
			Cancel
		</md-button>
		<span flex></span>
		<md-button ng-click="addon.edit.code.applyDiff('right')">
			Apply {{diffs.right.title}}
		</md-button>
	</md-dialog-actions>
</md-dialog>