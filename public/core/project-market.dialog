 <md-dialog style="width: 400px; max-width:90%;">
	<md-toolbar>
		<div class="md-toolbar-tools">
			<!--<md-button class="md-icon-button" ng-click="js.pipeline.link()"><i class="fa fa-link"></i></md-button>-->
			<h2 flex>{{package.meta.title}}</h2>
			<md-button class="md-icon-button" aria-label="close" ng-click="$mdDialog.hide()"><i class="fa fa-close"></i></md-button>
		</div>
	</md-toolbar>
	<md-content>
		<div layout-padding>
			<p><b>Created By:</b>		{{package.meta.createdBy.displayName}} ({{package.serverMeta.ip}})
			<br><b>Created From:</b> 	{{package.serverMeta.origin}}
			<br><b>Created On:</b>		{{moment(package.serverMeta.createdOn).calendar()}}
			<br>{{package.meta.description}}</p>
			<p ng-hide="package.meta.price"><b>Price:</b> Free</p>
			<p ng-show="package.meta.price"><b>Price:</b> {{package.meta.price}}/{{package.meta.unit}}</p>
		</div>
	</md-content>
	<md-dialog-actions layout="row">
		<!--<md-button class="md-raised" aria-label="Add" ng-click="addon.email.add()">Add</md-button>-->
		<span flex></span>
		<md-button class="md-raised" aria-label="Purchase" ng-click="addon.edit.browse.purchase(package)" ng-show="$scope.edit.browse == 'Market'">Purchase</md-button>
		<md-button class="md-raised" aria-label="Use" ng-click="addon.edit.browse.purchase(package)" ng-hide="$scope.edit.browse == 'Market'">Use</md-button>
	</md-dialog-actions>
</md-dialog>