<div class="insight-sidebar">
	<md-toolbar class="md-hue-2">
		<div class="md-toolbar-tools">
			<h2 flex md-truncate>A Insight</h2>

			<md-button class="md-icon-button" aria-label="Toggle Insight" ng-click="addon.editAi.$insightOn = !addon.editAi.$insightOn; addon.editAi.insight(addon.edit.$tab);">
				<i class="fa fa-chevron-up" 	ng-show="addon.editAi.$insightOn"></i>
				<i class="fa fa-chevron-down"	ng-hide="addon.editAi.$insightOn"></i>
			</md-button>
		</div>
	</md-toolbar>
	
	<div layout="column" flex fill class="edit-ai-container" ng-show="addon.editAi.$insightOn">
	    <!-- Input Area -->
	    <div>
	        <md-input-container class="md-block iGrow">
	            <label>System Instructions</label>
	            <textarea ng-model="addon.editAi._systemInstructions" ng-blur="addon.editAi.insight(tab)" md-no-autogrow placeholder="Instructions"></textarea>
	        </md-input-container>
	        
	        <md-input-container class="md-block iGrow">
	            <label>Custom Instructions</label>
	            <textarea ng-model="addon.editAi._userInstructions" ng-blur="addon.editAi.insight(tab)" md-no-autogrow placeholder="Instructions"></textarea>
	        </md-input-container>
	        
	        <md-input-container class="md-block iGrow">
	            <label>Custom Objective / Question</label>
	            <textarea ng-model="addon.editAi._userInput" ng-blur="addon.editAi.insight(tab)" md-no-autogrow placeholder="Question"></textarea>
	        </md-input-container>
			<md-progress-linear md-mode="indeterminate" ng-if="addon.editAi._isProcessing"></md-progress-linear>
	    </div>
	    <!-- Feedback Area -->
	    <div flex layout-padding>
			<div ng-if="addon.editAi._feedback" class="pre" markdown="{{addon.editAi._feedback.summary}}"></div>
			<div ng-if="addon.editAi._feedback" class="pre" markdown="{{addon.editAi._feedback.evaluation}}"></div>
	    </div>
	</div>
	<style>
		.iGrow textarea{
			min-height: 60px;
			overflow: auto;
		}
		.iGrow textarea:focus{
			min-height: 300px!important;
		}
	</style>
</div>